  "user-setting": {
    "mode": "Settings.theme (light | dark | system)",
    "light": "app_hub setting appearance.light_theme",
    "dark": "app_hub setting appearance.dark_theme"
  },
  "roles": {
    "background": "window / grouped background",
    "sidebar": "sidebar, navigation rail",
    "surface": "subtle cards, group backgrounds, tiles",
    "raised": "content panes, cells, text fields, dialogs, menus",
    "text": "primary text and icons",
    "text-secondary": "secondary text, captions",
    "text-tertiary": "placeholders, disabled text (never for content)",
    "separator": "hairlines, borders",
    "accent": "primary buttons, selection, switches, focus, links in dark",
    "accent-strong": "pressed / hover accent, links on light where accent < 4.5:1",
    "on-accent": "text and icons on accent fills",
    "accent-subtle": "selected rows, info banners, chips",
    "link": "link text",
    "selection": "selected list/table rows (non-macOS)",
    "control-fill": "secondary buttons, search fields, segmented track",
    "control-fill-strong": "progress tracks, pressed secondary",
    "focus-ring": "keyboard focus ring",
    "scrim": "modal scrim colour (with scrim-opacity)"
  },
